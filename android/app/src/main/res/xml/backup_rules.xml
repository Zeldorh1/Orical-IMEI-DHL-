<?xml version="1.0" encoding="utf-8"?>
<!--
Backup rules used by Android <= 11 (full-backup content).
Includes only the SharedPreferences that holds device-info state.
Excludes any Flutter framework caches that have no reason to persist.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
